---
// SPDX-License-Identifier: Apache-2.0
interface Item {
  name: string;
  url: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const json = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
}).replace(/</g, "\\u003c");
---
<script type="application/ld+json" set:html={json}></script>
