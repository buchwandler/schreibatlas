---
// SPDX-License-Identifier: Apache-2.0
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import BreadcrumbJsonLd from "../../../../../../components/BreadcrumbJsonLd.astro";
import NormalizedGuidelines from "../../../../../../components/NormalizedGuidelines.astro";
import GlyphOutline from "../../../../../../components/GlyphOutline.astro";
import FontGlyphPreview from "../../../../../../components/FontGlyphPreview.astro";
import FontProvenance from "../../../../../../components/FontProvenance.astro";
import { unicodeCodePoints } from "../../../../../../../tools/unicode.mjs";
import SourceList from "../../../../../../components/SourceList.astro";
import VerificationBadge from "../../../../../../components/VerificationBadge.astro";
import StrokeRenderer from "../../../../../../components/StrokeRenderer.astro";
import { messages, type Locale } from "../../../../../../lib/i18n";
import { withBase } from "../../../../../../lib/routes";
import { localizedLetterPaths, loadContent } from "../../../../../../../tools/content.mjs";
import type { Content, FontRecord, GlyphRecord, ModelRecord, SourceRecord, StrokeRecord } from "../../../../../../../tools/content.mjs";

import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { parseStrokeSvg } from "../../../../../../../tools/stroke-assets.mjs";
export function getStaticPaths() {
  const content = loadContent();
  return localizedLetterPaths(content.models, content.glyphs).map(({ lang, id, slug, glyph, character, model }) => ({
    params: { lang, id, slug },
    props: { glyph, character, model, content },
  }));
}

const { glyph, character, model, content } = Astro.props as { glyph?: GlyphRecord; character: string; model: ModelRecord; content: Content };
const unicode = unicodeCodePoints(character);
const lang = Astro.params.lang as Locale;
const copy = messages[lang];
const localized = (values: Record<string, string> | undefined) => values?.[lang] ?? values?.en ?? values?.de ?? copy.notRecorded;
const modelName = localized(model.name);
const slug = Astro.params.slug;
const title = `${copy.letterTitle} ${character} · ${modelName}`;
const stroke = content.strokes.find((entry) => entry.model === model.id && entry.character === character) as StrokeRecord | undefined;
const strokeDiagramSteps = stroke ? [...stroke.strokes].sort((left, right) => left.order - right.order).map((step) => ({
  ...step,
  paths: parseStrokeSvg(readFileSync(resolve(process.cwd(), step.file), "utf8"), step.file).paths,
})) : [];
const font = content.fonts.find((entry) => entry.id === (glyph?.reference.font ?? model.reference_fonts[0])) as FontRecord | undefined;
const sourceIds = [...new Set([...model.sources, ...(glyph?.sources ?? []), ...(stroke?.sources ?? []), ...(font?.sources ?? [])])];
const sourceMap = new Map(content.sources.map((source) => [source.id, source]));
const sources = sourceIds.flatMap((id) => sourceMap.has(id) ? [sourceMap.get(id)!] : []) as SourceRecord[];
const fontLicenseFilename = font?.license_file?.split("/").at(-1);
const fontLicenseUrl = font?.license_file_url ?? (font && fontLicenseFilename ? withBase(`data/v1/assets/fonts/${font.id}/${fontLicenseFilename}`) : null);
const site = Astro.site ?? new URL("https://schreibatlas.de");
const breadcrumbItems = [
  { name: copy.home, url: new URL(`/${lang}/`, site).href },
  { name: copy.exploreNavigation, url: new URL(`/${lang}/explore/`, site).href },
  { name: modelName, url: new URL(`/${lang}/models/${model.id}/`, site).href },
  { name: copy.repertoire, url: new URL(`/${lang}/models/${model.id}/letters/`, site).href },
  { name: character, url: new URL(`/${lang}/models/${model.id}/letters/${slug}/`, site).href },
];
const connectionText = (present: boolean | null) => present === null ? copy.unknown : present ? copy.present : copy.absent;
const directionText: Record<string, string> = { forward: copy.forward, reverse: copy.reverse, unknown: copy.unknown };
---
<BaseLayout lang={lang} title={title} description={`${copy.letterTitle} ${character} in ${modelName}.`} canonicalPath={`/${lang}/models/${model.id}/letters/${slug}/`}>
  <BreadcrumbJsonLd items={breadcrumbItems} />
  <div class="content-page">
    <nav class="breadcrumbs" aria-label={copy.breadcrumbNavigation}>
      <a href={withBase(`${lang}/`)}>{copy.home}</a>
      <span aria-hidden="true">/</span>
      <a href={withBase(`${lang}/explore/`)}>{copy.exploreNavigation}</a>
      <span aria-hidden="true">/</span>
      <a href={withBase(`${lang}/models/${model.id}/`)}>{modelName}</a>
      <span aria-hidden="true">/</span>
      <a href={withBase(`${lang}/models/${model.id}/letters/`)}>{copy.repertoire}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page"><code>{unicode.join(", ")}</code></span>
    </nav>

    <header class="page-heading letter-heading">
      <p class="eyebrow">{copy.letterTitle} · {modelName}</p>
      <h1>{title}</h1>
      {glyph ? <VerificationBadge lang={lang} status={glyph.verification} /> : <p class="empty-state">{copy.noGlyphRecords}</p>}
      {model.demo && <p class="demo-marker">{copy.demoTitle}</p>}
    </header>

    <section class="data-section glyph-record" aria-labelledby="character-title">
      <h2 id="character-title">{copy.character}</h2>
      <p class="character-display" aria-label={`${copy.character}: ${character}`}>{character}</p>
      <p>{copy.unicodeOnly}</p>
      {glyph?.outline ? <GlyphOutline lang={lang} outline={glyph.outline} label={`${copy.letterTitle} ${character} · ${modelName}`} id={`letter-${model.id}-${slug}`} /> : <FontGlyphPreview lang={lang} character={character} font={font} />}
      <dl class="metadata-list">
        <dt>{copy.codePoints}</dt><dd><code>{unicode.join(", ")}</code></dd>
        <dt>{copy.licenseAttribution}</dt><dd>{glyph?.license ?? model.license}</dd>
      </dl>
    </section>

    <section class="data-section" aria-labelledby="guidelines-title">
      <h2 id="guidelines-title">{copy.normalizedGuidelines}</h2>
      <NormalizedGuidelines lang={lang} metrics={glyph?.metrics ?? model.metrics} label={`${copy.normalizedGuidelines}: ${character}`} />
    </section>

    <section class="data-section" aria-labelledby="forms-title">
      <h2 id="forms-title">{copy.glyphForms}</h2>
      <div class="detail-grid">
        <article class="detail-card">
          <h3>{copy.isolatedForm}</h3>
          {glyph ? <VerificationBadge lang={lang} status={glyph.forms.isolated.status} /> : <p>{copy.noGlyphRecords}</p>}
        </article>
        <article class="detail-card">
          <h3>{copy.contextualForms}</h3>
          {(glyph?.forms.contextual ?? []).length > 0 ? (
            <ul>{(glyph?.forms.contextual ?? []).map((form, index) => <li>
              <p>{form.context} · {messages[lang].verification[form.status].label}</p>
              {form.outline ? <GlyphOutline lang={lang} outline={form.outline} label={`${copy.contextualForms} ${form.context} · ${character}`} id={`context-${model.id}-${slug}-${index}`} /> : <p class="empty-state">{copy.noVectorOutline}</p>}
            </li>)}</ul>
          ) : (
            <p class="empty-state">{copy.noContextualForms}</p>
          )}
        </article>
      </div>
    </section>

    <section class="data-section" aria-labelledby="connections-title">
      <h2 id="connections-title">{copy.connections}</h2>
      <dl class="metadata-list">
        <dt>{copy.entryConnection}</dt><dd>{connectionText(glyph?.connections.entry.present ?? null)}</dd>
        <dt>{copy.exitConnection}</dt><dd>{connectionText(glyph?.connections.exit.present ?? null)}</dd>
      </dl>
    </section>

    <section class="data-section" aria-labelledby="variants-title">
      <h2 id="variants-title">{copy.variants}</h2>
      {(glyph?.variants ?? []).length > 0 ? <ul>{(glyph?.variants ?? []).map((variant) => <li>{typeof variant === "string" ? variant : localized(variant.label)}</li>)}</ul> : <p class="empty-state">{copy.noVariants}</p>}
    </section>

    <section class="data-section" aria-labelledby="strokes-title">
      <h2 id="strokes-title">{copy.strokeInstructions}</h2>
      {stroke ? (
        <>
          <VerificationBadge lang={lang} status={stroke.verification} />
          <StrokeRenderer id={`stroke-${model.id}-${slug}`} steps={strokeDiagramSteps} copy={copy} />
          <ol class="stroke-steps">
            {stroke.strokes.map((step) => (
              <li>
                <strong>{copy.strokeNumber.replace("{number}", String(step.order))}</strong>
                <span>{copy.direction}: {step.direction ? directionText[step.direction] ?? step.direction : copy.unknown}</span>
                <span>{copy.penContact}: {step.pen_down ? copy.penDown : copy.penUp}</span>
                <span>{copy.start}: [{step.start.join(", ")}] · {copy.end}: [{step.end.join(", ")}]</span>
              </li>
            ))}
          </ol>
          <p>{copy.licenseAttribution}: {stroke.license}</p>
        </>
      ) : (
        <p class="empty-state">{copy.noStrokeInstructions}</p>
      )}
    </section>

    <section class="data-section" aria-labelledby="font-title">
      <h2 id="font-title">{copy.fontInformation}</h2>
      {font ? (
        <article class="font-card">
          <h3>{font.name}</h3>
          <p>{font.author}</p>
          <dl class="metadata-list">
            <dt>{copy.licenseAttribution}</dt><dd>{font.license}</dd>
            <dt>{copy.fontCorrespondence}</dt><dd>{copy.fontDegree[font.correspondence.degree]}</dd>
            <dt>{copy.character}</dt><dd>{glyph?.reference.glyph_name ?? copy.notRecorded}</dd>
          </dl>
          {font.license_file && fontLicenseUrl && <p><strong>{copy.licenseFile}:</strong> <a href={fontLicenseUrl}>{font.license_file}</a></p>}
          {font.correspondence.notes && <p>{font.correspondence.notes}</p>}
          <FontProvenance lang={lang} font={font} />
          {font.project_url && /^https?:\/\//i.test(font.project_url) && <a href={font.project_url} rel="external">{font.name}</a>}
        </article>
      ) : (
        <p class="empty-state">{copy.noFonts}</p>
      )}
    </section>

    <SourceList lang={lang} sources={sources} />
    <p class="page-return-links">
      <a class="text-link" href={withBase(`${lang}/models/${model.id}/`)}>{modelName}</a>
      <a class="text-link" href={withBase(`${lang}/models/${model.id}/letters/`)}>{copy.viewRepertoire}</a>
    </p>
  </div>
</BaseLayout>
