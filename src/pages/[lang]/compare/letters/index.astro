---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { messages, type Locale } from "../../../../lib/i18n";
import { withBase } from "../../../../lib/routes";
import { loadContent, locales } from "../../../../../tools/content.mjs";
import type { Content } from "../../../../../tools/content.mjs";

export function getStaticPaths() {
  const content = loadContent();
  return locales.map((lang) => ({ params: { lang }, props: { lang, content } }));
}

const { lang, content } = Astro.props as { lang: Locale; content: Content };
const copy = messages[lang];
const localized = (values: Record<string, string>) => values[lang] ?? values.en ?? values.de ?? "";
const pageData = {
  models: content.models.map((model) => ({ id: model.id, name: localized(model.name), country: model.country, metrics: model.metrics })),
  countries: content.countries.map((country) => ({ id: country.id, name: localized(country.name) })),
};
const messageData = {
  allCountries: copy.allCountries,
  loadingGlyphs: copy.loadingGlyphs,
  noComparableGlyphs: copy.noComparableGlyphs,
  noVectorOutline: copy.noVectorOutline,
  glyphLoadError: copy.glyphLoadError,
  comparisonSummary: copy.comparisonSummary,
  copySuccess: copy.copySuccess,
  copyError: copy.copyError,
  overlay: copy.overlay,
  sources: copy.sources,
  noSources: copy.noSources,
  licenseAttribution: copy.licenseAttribution,
  sourceAuthor: copy.sourceAuthor,
  sourceYear: copy.sourceYear,
  sourcePages: copy.sourcePages,
  sourceNotes: copy.sourceNotes,
  sourceOpen: copy.sourceOpen,
  verification: copy.verification,
};
const safeJson = (value: unknown) => JSON.stringify(value).replaceAll("<", "\\u003c");
const initialStatus = content.glyphs.length ? copy.loadingGlyphs : copy.noComparableGlyphs;
---
<BaseLayout lang={lang} title={copy.compareTitle} description={copy.compareDescription} canonicalPath={`/${lang}/compare/letters/`} section="compare">
  <div class="content-page letter-comparison" data-letter-comparison data-index-url={withBase("data/v1/index.json")}>
    <nav class="breadcrumbs" aria-label={copy.breadcrumbNavigation}>
      <a href={withBase(`${lang}/`)}>{copy.home}</a>
      <span aria-current="page">{copy.compareTitle}</span>
    </nav>
    <header class="page-heading">
      <h1>{copy.compareTitle}</h1>
      <p>{copy.compareDescription}</p>
      <p class="comparison-disclaimer">{copy.outlineDisclaimer}</p>
      <nav class="comparison-related-links" aria-label={copy.compareTitle}>
        <a href={withBase(`${lang}/compare/words/`)}>{copy.wordTitle}</a>
      </nav>
    </header>

    <section class="comparison-controls" aria-label={copy.compareTitle}>
      <label for="compare-country">{copy.compareCountry}
        <select id="compare-country"><option value="">{copy.allCountries}</option></select>
      </label>
      <label for="compare-character">{copy.compareCharacter}
        <select id="compare-character" disabled><option value="">{initialStatus}</option></select>
      </label>
      <label for="compare-model-a">{copy.compareModelA}
        <select id="compare-model-a" disabled></select>
      </label>
      <label for="compare-model-b">{copy.compareModelB}
        <select id="compare-model-b" disabled></select>
      </label>
      <label for="compare-mode">{copy.compareMode}
        <select id="compare-mode">
          <option value="side-by-side">{copy.sideBySide}</option>
          <option value="overlay">{copy.overlay}</option>
        </select>
      </label>
      <label class="comparison-opacity" for="compare-opacity">{copy.opacity}
        <input id="compare-opacity" type="range" min="0.1" max="1" step="0.05" value="0.5" />
        <output id="compare-opacity-value" for="compare-opacity">50%</output>
      </label>
      <fieldset class="comparison-guides">
        <legend>{copy.normalizedGuidelines}</legend>
        <label for="compare-baseline"><input id="compare-baseline" type="checkbox" checked /> {copy.showBaseline}</label>
        <label for="compare-x-height"><input id="compare-x-height" type="checkbox" checked /> {copy.showXHeight}</label>
        <label for="compare-bounds"><input id="compare-bounds" type="checkbox" /> {copy.showBounds}</label>
      </fieldset>
    </section>

    <div class="comparison-share">
      <label for="comparison-share-url">{copy.shareUrl}
        <input id="comparison-share-url" type="url" readonly />
      </label>
      <button id="comparison-copy-link" type="button">{copy.copyLink}</button>
    </div>
    <p id="comparison-status" class="comparison-status" role="status" aria-live="polite">{initialStatus}</p>
    <p id="comparison-summary" class="comparison-summary" aria-live="polite"></p>
    <div id="comparison-provenance" class="comparison-provenance" role="region" aria-label={copy.sources}></div>
    <div id="comparison-stage" class="comparison-stage" role="group" aria-label={copy.compareTitle}></div>
    <noscript><p>{copy.compareDescription}</p></noscript>

    <script id="comparison-data" type="application/json" set:html={safeJson(pageData)}></script>
    <script id="comparison-messages" type="application/json" set:html={safeJson(messageData)}></script>
  </div>
  <script>
    import "../../../../scripts/letter-comparison";
  </script>
</BaseLayout>
