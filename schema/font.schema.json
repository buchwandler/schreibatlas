{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schreibatlas.de/schema/v1/font.schema.json",
  "type": "object",
  "required": ["id", "name", "author", "project_url", "license", "files", "correspondence", "sources"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/fontId" },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "project_url": { "type": ["string", "null"] },
    "license": { "$ref": "common.schema.json#/$defs/licenseId" },
    "files": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "license_file": { "type": ["string", "null"] },
    "font_version": { "type": "string", "minLength": 1 },
    "format": { "enum": ["truetype", "opentype", "woff", "woff2"] },
    "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "style": { "enum": ["normal", "italic", "oblique"] },
    "family_name": { "type": "string", "minLength": 1 },
    "postscript_name": { "type": "string", "minLength": 1 },
    "upstream": {
      "oneOf": [
        {
          "type": "object",
          "required": ["repository", "release", "commit", "source_file"],
          "properties": {
            "repository": { "type": "string", "pattern": "^https://" },
            "release": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "source_file": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "project_url", "archive_url", "package", "version", "retrieved", "sha256", "source_file"],
          "properties": {
            "kind": { "const": "archive" },
            "project_url": { "type": "string", "pattern": "^https://" },
            "archive_url": { "type": "string", "pattern": "^https://" },
            "package": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "source_file": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "derivation": {
      "type": "object",
      "required": ["kind", "source_format", "output_format", "recipe", "toolchain", "unicode_mapping", "unicode_mapping_sha256", "tfm_file", "tfm_sha256", "provenance_file", "pipeline", "notes"],
      "properties": {
        "kind": { "const": "generated" },
        "source_format": { "type": "string", "minLength": 1 },
        "output_format": { "enum": ["truetype", "opentype", "woff", "woff2"] },
        "recipe": { "type": "string", "minLength": 1 },
        "toolchain": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "unicode_mapping": { "type": "string", "minLength": 1 },
        "unicode_mapping_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "connection_mapping": { "type": ["string", "null"], "minLength": 1 },
        "tfm_file": { "type": "string", "minLength": 1 },
        "tfm_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provenance_file": { "type": "string", "minLength": 1 },
        "provenance_file_url": { "type": "string", "minLength": 1 },
        "pipeline": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "integrity": {
      "description": "Integrity of the single pinned reference font asset.",
      "type": "object",
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "shaping": {
      "type": "object",
      "required": ["required_features", "language_tag", "direction"],
      "properties": {
        "required_features": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9]{4}$" }, "uniqueItems": true },
        "language_tag": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["ltr", "rtl"] }
      },
      "additionalProperties": false
    },
    "calibration": {
      "description": "Measured font x-height as a fraction of em, required for shared baseline/x-height rendering.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["x_height_em"],
          "properties": {
            "x_height_em": { "type": "number", "exclusiveMinimum": 0 },
            "ascender_em": { "type": ["number", "null"] },
            "x_height_method": { "type": "string", "minLength": 1 },
            "descender_em": { "type": ["number", "null"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "correspondence": {
      "type": "object",
      "required": ["model", "degree", "notes"],
      "properties": {
        "model": { "oneOf": [{ "$ref": "common.schema.json#/$defs/modelId" }, { "type": "null" }] },
        "degree": { "type": "string", "enum": ["complete", "partial", "visual-only", "unknown"] },
        "notes": { "type": ["string", "null"] },
        "scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "excludes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sourceId" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/sourceId" },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "required": ["integrity"] },
      "then": { "properties": { "files": { "minItems": 1, "maxItems": 1 } }, "required": ["font_version", "upstream", "license_file"] }
    },
    {
      "if": { "properties": { "calibration": { "type": "object" } }, "required": ["calibration"] },
      "then": {
        "properties": {
          "correspondence": { "properties": { "model": { "not": { "type": "null" } } } },
          "sources": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "upstream": { "required": ["kind"], "properties": { "kind": { "const": "archive" } } } },
        "required": ["upstream"]
      },
      "then": { "required": ["derivation"] }
    },
    {
      "if": {
        "properties": { "derivation": { "properties": { "kind": { "const": "generated" } } } },
        "required": ["derivation"]
      },
      "then": {
        "required": ["upstream", "integrity", "font_version", "format", "family_name", "postscript_name", "shaping", "calibration"],
        "properties": {
          "upstream": { "required": ["kind"], "properties": { "kind": { "const": "archive" } } },
          "files": { "minItems": 1, "maxItems": 1 },
          "format": { "const": "truetype" },
          "derivation": { "properties": { "output_format": { "const": "truetype" } } },
          "calibration": { "type": "object" }
        }
      }
    }
  ],
  "additionalProperties": false
}
