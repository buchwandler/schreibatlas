{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schreibatlas.de/schema/v1/stroke.schema.json",
  "type": "object",
  "required": ["model", "character", "verification", "strokes", "sources", "license"],
  "properties": {
    "model": { "$ref": "common.schema.json#/$defs/modelId" },
    "character": { "type": "string", "minLength": 1 },
    "verification": { "$ref": "common.schema.json#/$defs/verificationStatus" },
    "strokes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "file", "pen_down", "start", "end"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "pattern": "^assets/strokes/.+\\.svg$" },
          "pen_down": { "type": "boolean" },
          "start": { "$ref": "#/$defs/point" },
          "end": { "$ref": "#/$defs/point" },
          "direction": { "type": ["string", "null"], "enum": ["forward", "reverse", "unknown", null] },
          "timing_ms": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourceId" },
      "uniqueItems": true
    },
    "license": { "$ref": "common.schema.json#/$defs/licenseId" }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verification": { "enum": ["source-backed", "reviewed", "verified"] } }, "required": ["verification"] },
      "then": { "properties": { "sources": { "minItems": 1 } } }
    }
  ],
  "additionalProperties": false
}
